<% @indent = 1 if not @indent %>
<% ind = '  ' * @indent %>
<% @config.each do |key, val| %>
<%   next if key.start_with?('_') %>
<%   if val.is_a?(Array) %>
<%=    ind %><%=      key  %> = [<%= val.map { |v| v.is_a?(String) ? "\"#{v}\"" : v }.join(', ') %>]
<%   elsif val.is_a?(Integer) || val.is_a?(Float) %>
<%=    ind %><%=      key  %> = <%= val %>
<%   elsif val.is_a?(String) %>
<%=    ind %><%=      key  %> = "<%= val %>"
<%   elsif val == true || val == false %>
<%=    ind %><%=    key  %> = <%= val %>
<%   elsif val.is_a?(Hash) %>
<%=    ind %>[<%=    key  %>]
<%=    render 'toml_hash.erb',
         :variables => { :config => val, :indent => @indent + 1} -%>
<%=    ind %>
<%   else %>
<%=    ind %><%=      key  %> = <%= val %>
<%   end %>
<% end %>
