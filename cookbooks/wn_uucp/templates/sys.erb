# overwritten. See wn_uucp/README.md

# Template defaults
protocol gvG
protocol-parameter G packet-size 1024
protocol-parameter G short-packets
protocol-parameter g packet-size 1024

# Extra defaults
<% node['wn_uucp']['sys']['defaults'].each do |k, v| -%>
<%=   k %> <%= v %>
<% end -%>

<% node['wn_uucp']['sys']['systems'].each do |system, data| -%>
# <%= system %>
system <%=  system %>
<%   data.each do |k, v| -%>
<%     if k == 'alternate' -%>
<%       v.each do |alt| -%>
<%         alt = alt.dup -%>
<%         alt_name = alt.delete('name') -%>
alternate<%= alt_name ? " #{alt_name}" : '' %>
<%         alt.each do |ak, av| -%>
<%=          ak %> <%= av %>
<%         end -%>
<%       end -%>
<%     else -%>
<%=      k %> <%= v %>
<%     end -%>
<%   end -%>

<% end %>
